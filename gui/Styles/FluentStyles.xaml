<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette - Windows 11 Fluent Dark (Default) -->
    <Color x:Key="ColorBgWindow">#181818</Color>
    <Color x:Key="ColorBgSidebar">#1F1F1F</Color>
    <Color x:Key="ColorBgCard">#252525</Color>
    <Color x:Key="ColorBgCardHover">#2C2C2C</Color>
    <Color x:Key="ColorBorder">#333333</Color>
    <Color x:Key="ColorBorderHighlight">#444444</Color>
    
    <Color x:Key="ColorAccent">#0078D4</Color>
    <Color x:Key="ColorAccentPurple">#7928CA</Color>
    <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#A0A0A0</Color>
    <Color x:Key="ColorTextMuted">#707070</Color>
    
    <Color x:Key="ColorSuccess">#107C41</Color>
    <Color x:Key="ColorWarning">#FFB800</Color>
    <Color x:Key="ColorError">#E81123</Color>

    <!-- Unified Button Palette -->
    <Color x:Key="ColorButtonBg">#2A2A2A</Color>
    <Color x:Key="ColorButtonBgHover">#333333</Color>
    <Color x:Key="ColorButtonBorder">#3D3D3D</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BrushBgWindow" Color="{StaticResource ColorBgWindow}"/>
    <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource ColorBgSidebar}"/>
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorBorderHighlight}"/>
    
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}"/>

    <SolidColorBrush x:Key="BrushButtonBg" Color="{StaticResource ColorButtonBg}"/>
    <SolidColorBrush x:Key="BrushButtonBgHover" Color="{StaticResource ColorButtonBgHover}"/>
    <SolidColorBrush x:Key="BrushButtonBorder" Color="{StaticResource ColorButtonBorder}"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0078D4" Offset="0"/>
        <GradientStop Color="#00BCF2" Offset="1"/>
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="FluentFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Fluent Card Style -->
    <Style x:Key="FluentCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Navigation Radio Button Style -->
    <Style x:Key="FluentNavButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource FluentFont}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="8,2,8,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Active Pill Indicator -->
                            <Rectangle x:Name="ActivePill" Grid.Column="0" Width="3" Height="16" Fill="{DynamicResource BrushAccent}" 
                                       HorizontalAlignment="Left" Margin="-8,0,8,0" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                            
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBgCard}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="ActivePill" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Unified Fluent Button Style: Consistent across ALL buttons (tek tarz buton) -->
    <Style x:Key="FluentButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushButtonBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{StaticResource FluentFont}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushButtonBgHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aliases so all button calls use the unified style -->
    <Style x:Key="FluentPrimaryButton" BasedOn="{StaticResource FluentButton}" TargetType="Button"/>
    <Style x:Key="FluentSecondaryButton" BasedOn="{StaticResource FluentButton}" TargetType="Button"/>
    <Style x:Key="FluentButtonPrimary" BasedOn="{StaticResource FluentButton}" TargetType="Button"/>

    <!-- Theme Toggle Header Button -->
    <Style x:Key="FluentThemeToggleBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource FluentFont}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Badge Style -->
    <Style x:Key="FluentBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <!-- Sidebar Toggle Hamburger Button Style -->
    <Style x:Key="FluentSidebarToggleBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modal Dialog Card Style -->
    <Style x:Key="FluentModalCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHighlight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.6" ShadowDepth="6"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
