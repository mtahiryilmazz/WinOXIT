                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="💥 Windows Olay Günlüğü &amp; BSOD Minidump Taraması" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Sistemdeki son kritik hata kayıtlarını ve minidump dökümlerini tarayarak çökmeye yol açan sürücüyü listeleyin." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="🤖 Sistem Sağlık &amp; Olay Günlüğü Taraması" Style="{StaticResource FluentButton}" Margin="0,0,10,6" Click="BtnAiEventScan_Click"/>
                                    <Button Content="💥 Mavi Ekran (BSOD) Minidump Analizi" Style="{StaticResource FluentButton}" Margin="0,0,10,6" Click="BtnAiBsodScan_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 12. VIEW: KATILIMSIZ ISO / WIM STÜDYOSU (SYSFORGE TRANSFERRED) -->
                    <StackPanel x:Name="PanelIsoStudio" Visibility="Collapsed">
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="💿 Katılımsız (Unattended) Windows 11 ISO &amp; WIM Stüdyosu" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="TPM 2.0, SecureBoot, RAM ve CPU kontrollerini bypass eden autounattend.xml ve DISM çevrimdışı sürücü enjeksiyonu." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                                <TextBlock Text="DONANIM KISITLAMALARI BYPASS &amp; KURULUM AYARLARI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <CheckBox x:Name="ChkIsoBypassTpm" Content="Bypass TPM 2.0" IsChecked="True" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,20,10"/>
                                    <CheckBox x:Name="ChkIsoBypassSecureBoot" Content="Bypass SecureBoot" IsChecked="True" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,20,10"/>
                                    <CheckBox x:Name="ChkIsoBypassRam" Content="Bypass 4GB RAM Sınırı" IsChecked="True" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,20,10"/>
                                    <CheckBox x:Name="ChkIsoBypassCpu" Content="Bypass Desteklenmeyen CPU" IsChecked="True" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,20,10"/>
                                    <CheckBox x:Name="ChkIsoBypassStorage" Content="Bypass 64GB Depolama &amp; VM" IsChecked="True" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,20,10"/>
                                </WrapPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Yerel Yönetici Kullanıcı Adı:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtIsoUser" Text="WinoxAdmin" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Padding="8,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Yönetici Parolası (Boş bırakılabilir):" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="TxtIsoPass" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Padding="8,6"/>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="BtnGenerateIsoXml" Content="⚡ autounattend.xml Oluştur &amp; Pencerede Önizle" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnGenerateIsoXml_Click"/>
                                    <Button x:Name="BtnOpenIsoWorkspace" Content="📂 ISO Çalışma Klasörünü Aç" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnOpenIsoWorkspace_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- DISM WIM Operations -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📦 DISM Çevrimdışı WIM İmaj ve Sürücü Enjeksiyonu" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="install.wim veya boot.wim dosyasını bağlayıp içine Universal NIC ve OEM sürücülerini internetsiz entegre edin." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="WIM Dosya Yolu:" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBox x:Name="TxtWimFilePath" Grid.Column="1" Text="C:\WinoxIT_Workspace\install.wim" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Padding="8,6" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Gözat..." Style="{StaticResource FluentButton}" Height="32" Click="BtnBrowseWim_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bağlama Dizini (Mount):" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBox x:Name="TxtWimMountDir" Grid.Column="1" Text="C:\WinoxIT_Mount" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Padding="8,6"/>
                                </Grid>

                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnWimMount" Content="📥 WIM İmajını Bağla (Mount)" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnWimMount_Click"/>
                                    <Button x:Name="BtnWimInjectDrivers" Content="📦 Universal NIC Sürücülerini Enjekte Et" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnWimInjectDrivers_Click"/>
                                    <Button x:Name="BtnWimCommit" Content="💾 Kaydet &amp; Kapat (Commit)" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnWimCommit_Click"/>
                                    <Button x:Name="BtnWimDiscard" Content="❌ İptal Et &amp; Kapat (Discard)" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnWimDiscard_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 13. VIEW: LAN FİLO DAĞITIMI & PUSH AGENT (SYSFORGE TRANSFERRED) -->
                    <StackPanel x:Name="PanelLanFleet" Visibility="Collapsed">
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📡 LAN Filo Keşfi &amp; Push Agent Yönetimi" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Aynı yerel ağdaki (Ethernet &amp; Wi-Fi) tüm cihazları tek tıkla keşfedin, Ping ve WinoxIT uzaktan sağlık taraması komutları gönderin." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="🔍 Ağdaki Cihazları Keşfet (ARP / NetNeighbor)" Style="{StaticResource FluentButton}" Height="36" Click="BtnDiscoverLanFleet_Click"/>
                                    
                                    <TextBox x:Name="TxtFleetTargetIp" Grid.Column="2" Text="192.168.1.1" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" VerticalContentAlignment="Center" Padding="8,4" Margin="0,0,8,0"/>
                                    <WrapPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Content="📡 Ping Gönder" Style="{StaticResource FluentButton}" Height="36" Margin="0,0,8,0" Click="BtnPingFleetTarget_Click"/>
                                        <Button Content="🛡️ Sağlık Taraması" Style="{StaticResource FluentButton}" Height="36" Click="BtnProbeFleetTarget_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <TextBlock Text="KEŞFEDİLEN AĞ CİHAZLARI LİSTESİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource BrushBgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" MinHeight="180" MaxHeight="280">
                                    <DataGrid x:Name="GridLanFleet" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" 
                                              BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                              Foreground="{DynamicResource BrushTextPrimary}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="IP Adresi" Binding="{Binding IPAddress}" Width="160"/>
                                            <DataGridTextColumn Header="MAC Adresi" Binding="{Binding MACAddress}" Width="180"/>
                                            <DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="140"/>
                                            <DataGridCheckBoxColumn Header="Erişilebilir" Binding="{Binding IsReachable}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- Bottom Live Output Console -->
            <Border Grid.Row="2" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 CANLI KONSOL ÇIKTISI &amp; LOG TERMİNALİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Temizle" Style="{StaticResource FluentButton}" Height="26" Padding="10,0" Click="BtnClearLog_Click"/>
                    </Grid>

                    <TextBox x:Name="TxtConsoleLog" Grid.Row="1" Background="Transparent" Foreground="{DynamicResource BrushAccent}" 
                             BorderThickness="0" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- In-App Modal Dialog Overlay (Popup Pencere) -->
        <Grid x:Name="ModalOverlay" Grid.ColumnSpan="2" Background="#A0000000" Visibility="Collapsed">
            <Border Style="{StaticResource FluentModalCard}" Width="780" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtModalTitle" Text="Detaylı Rapor &amp; Çıktı" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtModalSubtitle" Text="Modül içi anlık önizleme penceresi" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource FluentSidebarToggleBtn}" Width="30" Height="30" FontSize="14" Click="BtnCloseModal_Click" ToolTip="Kapat"/>
                    </Grid>

                    <!-- Modal Content Area -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushBgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <TextBox x:Name="TxtModalContent" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" 
                                 BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Modal Footer Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnModalCopy" Content="📋 Panoya Kopyala" Style="{StaticResource FluentButton}" Margin="0,0,10,0" Click="BtnModalCopy_Click"/>
                        <Button x:Name="BtnModalSave" Content="💾 Dosyaya Kaydet" Style="{StaticResource FluentButton}" Margin="0,0,10,0" Click="BtnModalSave_Click"/>
                        <Button Content="Kapat" Style="{StaticResource FluentButton}" Click="BtnCloseModal_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
