<Window x:Class="WinoxIT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinoxIT"
        mc:Ignorable="d"
        Title="WinoxIT v1.0.0 — Enterprise Windows IT, Hardware &amp; Deployment Suite" 
        Height="840" Width="1280"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgWindow}"
        FontFamily="{StaticResource FluentFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSidebar" Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Fluent Navigation Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header & Sidebar Toggle (Daralt / Genişlet) -->
                <StackPanel Grid.Row="0" Margin="14,16,14,12">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Logo Button (Tıklayınca Menüyü Daraltır / Açar) -->
                        <Border x:Name="BtnLogoToggle" Grid.Column="0" Width="38" Height="38" CornerRadius="9" 
                                Background="{StaticResource BrushAccentGradient}" Margin="0,0,10,0" Cursor="Hand"
                                ToolTip="Menüyü Daralt / Genişlet (WinoxIT)" MouseLeftButtonUp="BtnToggleSidebar_Click">
                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel x:Name="BrandTextStack" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="BtnToggleSidebar_Click">
                            <TextBlock Text="WinoxIT" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Enterprise IT Suite" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>

                        <!-- Hamburger Toggle Button -->
                        <Button x:Name="BtnToggleSidebar" Grid.Column="2" Content="☰" Style="{StaticResource FluentSidebarToggleBtn}"
                                ToolTip="Menüyü Daralt / Genişlet" Click="BtnToggleSidebar_Click" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,4"/>
                </StackPanel>

                <!-- Navigation Menu Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,0">
                        <TextBlock x:Name="TxtNavSection1" Text="KONTROL MERKEZİ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="18,6,18,3"/>
                        <RadioButton x:Name="NavDashboard" Content="📊  Genel Bakış &amp; Durum" ToolTip="Genel Bakış &amp; Durum" Style="{StaticResource FluentNavButton}" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLanServer" Content="🌐  Sanal Web Sunucu (LAN)" ToolTip="Sanal Web Sunucu (LAN)" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>

                        <TextBlock x:Name="TxtNavSectionSysForge" Text="İMAJ &amp; AĞ FİLOSU (SYSFORGE)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="18,12,18,3"/>
                        <RadioButton x:Name="NavIsoStudio" Content="💿  Katılımsız ISO / WIM Stüdyosu" ToolTip="Katılımsız ISO / WIM Stüdyosu" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLanFleet" Content="📡  LAN Filo &amp; Push Agent" ToolTip="LAN Filo &amp; Push Agent" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>

                        <TextBlock x:Name="TxtNavSection2" Text="DONANIM &amp; EKSPERTİZ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="18,12,18,3"/>
                        <RadioButton x:Name="NavHardware" Content="🛡️  Donanım Ekspertizi &amp; HWID" ToolTip="Donanım Ekspertizi &amp; HWID" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDrivers" Content="📦  Sürücüler &amp; Offline NIC" ToolTip="Sürücüler &amp; Offline NIC" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPrinters" Content="🖨️  Yazıcı &amp; Spooler Onarımı" ToolTip="Yazıcı &amp; Spooler Onarımı" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>

                        <TextBlock x:Name="TxtNavSection3" Text="YAZILIM &amp; DAĞITIM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="18,12,18,3"/>
                        <RadioButton x:Name="NavAppDeploy" Content="🛒  Kurumsal AppDeploy (Winget)" ToolTip="Kurumsal AppDeploy (Winget)" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>

                        <TextBlock x:Name="TxtNavSection4" Text="SİSTEM ONARIMI &amp; GİZLİLİK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="18,12,18,3"/>
                        <RadioButton x:Name="NavCleaner" Content="🧹  Sistem Temizliği &amp; Cache" ToolTip="Sistem Temizliği &amp; Cache" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDebloat" Content="⚡  Win 11 Debloat &amp; Gizlilik" ToolTip="Win 11 Debloat &amp; Gizlilik" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNetwork" Content="📶  Ağ &amp; DNS &amp; TCP/IP Onarım" ToolTip="Ağ &amp; DNS &amp; TCP/IP Onarım" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>

                        <TextBlock x:Name="TxtNavSection5" Text="YÖNETİM &amp; ANALİZ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="18,12,18,3"/>
                        <RadioButton x:Name="NavDiagnostics" Content="🔧  Çekirdek Sistem Onarımı" ToolTip="Çekirdek Sistem Onarımı" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavProcesses" Content="⚙️  İşlemler &amp; Hizmetler" ToolTip="İşlemler &amp; Hizmetler" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStartup" Content="🚀  Başlangıç Yöneticisi" ToolTip="Başlangıç Yöneticisi" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAI" Content="🤖  Yapay Zekâ Tanılama" ToolTip="Yapay Zekâ Tanılama" Style="{StaticResource FluentNavButton}" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Bottom Status Footer -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource BrushBgSidebar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="TxtSidebarFooterText" Grid.Column="0">
                            <TextBlock Text="WinoxIT v1.0.0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtServerMiniStatus" Text="Sunucu: Kontrol ediliyor..." FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource FluentBadge}" HorizontalAlignment="Center">
                            <TextBlock Text="NET 8 / RUST" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Quick Launcher -->
            <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="📊 Genel Bakış &amp; Durum" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Tüm çekirdek modüller, donanım parmak izi ve ağ operasyonları hazır." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Theme Toggle Button (Açık / Koyu Tema) -->
                        <Button x:Name="BtnThemeToggle" Content="🌙 Koyu Tema" Style="{StaticResource FluentThemeToggleBtn}" Margin="0,0,10,0" Click="BtnThemeToggle_Click"/>
                        
                        <!-- Action buttons: All in single unified style -->
                        <Button x:Name="BtnQuickServer" Content="🌐 Web Kokpitini Aç (Port 9999)" Style="{StaticResource FluentButton}" Margin="0,0,10,0" Click="BtnQuickServer_Click"/>
                        <Button x:Name="BtnQuickClean" Content="🧹 Hızlı Temizle" Style="{StaticResource FluentButton}" Margin="0,0,10,0" Click="BtnQuickClean_Click"/>
                        <Button x:Name="BtnFlushDns" Content="📡 DNS Temizle" Style="{StaticResource FluentButton}" Click="BtnFlushDns_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area with Dynamic Views -->
            <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
                <Grid>

                    <!-- 1. VIEW: DASHBOARD -->
                    <StackPanel x:Name="PanelDashboard" Visibility="Visible">
                        <!-- Metric Cards -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource FluentCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="SİSTEM DURUMU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="TxtHealthStatus" Text="SAĞLIKLI (%98)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" Margin="0,6,0,0"/>
                                    <TextBlock Text="0 Kritik Sistem Sorunu" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource FluentCard}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="İŞLEMCİ YÜKÜ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="TxtCpuLoad" Text="%12" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="TxtCpuName" Text="16 Çekirdek Aktif" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource FluentCard}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="BELLEK KULLANIMI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="TxtMemoryUsage" Text="%42" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushAccentPurple}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="TxtRamDetails" Text="RAM Durumu Aktif" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource FluentCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="AĞ KOKPİTİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="TxtServerStatus" Text="0.0.0.0:9999" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="TxtServerSub" Text="Çoklu Cihaz Hazır" FontSize="11" Foreground="{DynamicResource BrushSuccess}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Dynamic Action Panel -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚡ Hızlı Operasyonlar ve Çekirdek İşlemler" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="🛡️ HWID Parmak İzi Oluştur" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnGenHwid_Click"/>
                                    <Button Content="🖨️ 0x11b &amp; 0x709 Yazıcı Onar" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnFixPrinters_Click"/>
                                    <Button Content="🛑 Spooler Servisini Temizle &amp; Başlat" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnPurgeSpooler_Click"/>
                                    <Button Content="🚀 Win11 Copilot &amp; Recall Kapat" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnDisableCopilot_Click"/>
                                    <Button Content="🖱️ Klasik Sağ Tık Menüsünü Aç" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnClassicMenu_Click"/>
                                    <Button Content="🧹 %TEMP% ve Önbellek Temizle" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnCleanTemp_Click"/>
                                    <Button Content="🔧 SFC Dosya Taramasını Başlat" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnRunSfc_Click"/>
                                    <Button Content="💾 DISM İmaj Onarımını Başlat" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnRunDism_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- System Information Spec Box -->
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <TextBlock Text="💻 Algılanan Donanım &amp; İşletim Sistemi Profili" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <TextBox x:Name="TxtSpecs" Height="140" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}" 
                                         BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12" 
                                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- 2. VIEW: SANAL WEB SUNUCU (LAN) -->
                    <StackPanel x:Name="PanelLanServer" Visibility="Collapsed">
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🌐 WinoxIT Sanal Ağ Sunucusu ve Cyber HUD Kokpiti" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Node.js tabanlı yüksek eşzamanlı sanal sunucu 0.0.0.0:9999 üzerinden ağdaki tüm cihazlara açıktır." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource BrushSuccess}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLanServerBigStatus" Grid.Column="1" Text="Sunucu Durumu: Kontrol Ediliyor..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="BtnStartServer" Content="▶️ Sunucuyu Başlat" Style="{StaticResource FluentButton}" Margin="0,0,8,0" Click="BtnStartServer_Click"/>
                                        <Button x:Name="BtnStopServer" Content="⏹️ Durdur" Style="{StaticResource FluentButton}" Margin="0,0,8,0" Click="BtnStopServer_Click"/>
                                        <Button x:Name="BtnOpenDashboard" Content="🌐 Tarayıcıda Aç" Style="{StaticResource FluentButton}" Margin="0,0,8,0" Click="BtnOpenDashboard_Click"/>
                                        <Button x:Name="BtnFirewallFix" Content="🛡️ Güvenlik Duvarı Aç" Style="{StaticResource FluentButton}" Click="BtnFirewallFix_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,16"/>

                                <TextBlock Text="📱 LAN / Wi-Fi Erişim Adresleri (Mobil Cihazlar ve Ağdaki Bilgisayarlar):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                                <TextBox x:Name="TxtLanAddresses" Height="110" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushAccent}" 
                                         BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12" 
                                         FontFamily="Consolas" FontSize="13" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>

                                <TextBlock Text="💡 İpucu: Telefonunuzdan veya aynı Wi-Fi ağındaki herhangi bir cihazdan yukarıdaki IP adreslerinden birini tarayıcınıza yazarak tüm WinoxIT kokpitine uzaktan erişebilirsiniz." 
                                           FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- 3. VIEW: DONANIM & HWID -->
                    <StackPanel x:Name="PanelHardware" Visibility="Collapsed">
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🛡️ Kriptografik HWID Parmak İzi &amp; Parça Değişim Tespiti (Anti-Tamper)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Anakart, CPU, RAM slotları ve SSD seri numaralarından deterministik SHA-256 hash üretilir. Servis veya periyodik denetimlerde parça sökülmesi/değişmesi kırmızı alarmla tespit edilir." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="🛡️ HWID Baseline Referansı Oluştur" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnGenHwid_Click"/>
                                    <Button Content="💾 Baseline Referansını Kaydet" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnSaveBaselineToFile_Click"/>
                                    <Button Content="🔍 Parça Değişim / Drift Taraması Yap" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnCheckDrift_Click"/>
                                    <Button Content="📄 Ekspertiz / Zimmet Raporu Çıkar" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnExportHwidReport_Click"/>
                                    <Button Content="🔑 Anakart OEM Windows Lisansını Oku" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnReadOemKey_Click"/>
                                </WrapPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Mevcut Donanım Parmak İzi (SHA-256):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                        <TextBox x:Name="TxtHwidDetails" Height="170" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}" 
                                                 BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12" 
                                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Donanım Sapması (Drift Diff) Analizi:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                        <TextBox x:Name="TxtDriftDiff" Height="170" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushAccent}" 
                                                 BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12" 
                                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                 Text="Henüz drift analizi çalıştırılmadı. 'Parça Değişim / Drift Taraması Yap' butonuna tıklayınız."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- 3.1 VIEW: SÜRÜCÜLER & OFFLINE NIC & OEM SÜRÜCÜ ORKESTRATÖRÜ -->
                    <StackPanel x:Name="PanelDrivers" Visibility="Collapsed">
                        <!-- Universal NIC Card -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🌐 Gömülü Evrensel Çevrimdışı Ağ Kartı Sürücü Enjektörü (Universal Offline NIC)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Format sonrası internet bağlantısı olmayan bilgisayarlara Intel, Realtek, Broadcom, MediaTek WHQL Ethernet ve Wi-Fi sürücülerini 5 saniyede internetsiz enjekte eder." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="BtnInstallOfflineNic" Content="🚀 Universal NIC Sürücülerini Enjekte Et" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnInstallOfflineNic_Click"/>
                                    <Button x:Name="BtnScanMissingDrivers" Content="🔍 Eksik / Hatalı Sürücüleri Tara" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnScanMissingDrivers_Click"/>
                                    <Button x:Name="BtnOpenDriversFolder" Content="📂 Sürücü Klasörünü Aç (drivers/)" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnOpenDriversFolder_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- OEM Hardware & Driver Card -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🏢 OEM Donanım / Anakart Tespiti &amp; Orijinal Sürücü İndirici" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Dell Command Update (dcu-cli), Lenovo System Update / ThinInstaller ve HP Image Assistant resmi kataloglarından temiz sürücü çeker." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="BtnDetectOem" Content="🔍 Anakart &amp; OEM Modelini Tara" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnDetectOem_Click"/>
                                    <Button x:Name="BtnTriggerOemUpdate" Content="⚡ Üretici Resmi Sürücü Motorunu Tetikle" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnTriggerOemUpdate_Click"/>
                                </WrapPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Tespit Edilen OEM / Anakart Profili:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
