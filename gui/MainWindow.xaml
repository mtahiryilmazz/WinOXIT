<Window x:Class="WinoxIT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinoxIT"
        mc:Ignorable="d"
        Title="WinoxIT v1.0.0 — Enterprise Windows IT, Hardware &amp; Deployment Suite" 
        Height="860" Width="1300"
        MinHeight="720" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgWindow}"
        FontFamily="{StaticResource FluentFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSidebar" Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Fluent Navigation Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header & Sidebar Toggle (Tek Tıkla Logo ile Daralt / Genişlet) -->
                <StackPanel Grid.Row="0" Margin="14,16,14,12">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Official Brand Logo Button (Menüyü Daraltır / Açar) -->
                        <Border x:Name="BtnLogoToggle" Grid.Column="0" Width="40" Height="40" CornerRadius="10" 
                                Background="{StaticResource BrushAccentGradient}" Margin="0,0,10,0" Cursor="Hand"
                                ToolTip="Menüyü Daralt / Genişlet (WinoxIT)" MouseLeftButtonUp="BtnToggleSidebar_Click">
                            <Image Source="logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel x:Name="BrandTextStack" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="BtnToggleSidebar_Click">
                            <TextBlock Text="WinoxIT" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Enterprise IT Suite" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,4"/>
                </StackPanel>

                <!-- Navigation Menu Items (5 Category Hubs) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock x:Name="TxtNavSectionHubs" Text="KATEGORİ MERKEZLERİ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="18,6,18,6"/>
                        
                        <!-- Hub 1: Kontrol Merkezi & Ağ Filosu -->
                        <RadioButton x:Name="NavHubDashboard" Content="📊  Kontrol Merkezi &amp; Ağ Filosu" ToolTip="Kontrol Merkezi, Sanal Sunucu, ISO Stüdyosu &amp; Ağ Filosu" Style="{StaticResource FluentNavButton}" IsChecked="True" Checked="NavHub_Checked"/>
                        
                        <!-- Hub 2: Donanım, Sürücüler & Yazıcı -->
                        <RadioButton x:Name="NavHubHardware" Content="🛡️  Donanım, Sürücüler &amp; Yazıcı" ToolTip="Donanım Ekspertizi, Sürücüler &amp; Yazıcı Onarımı" Style="{StaticResource FluentNavButton}" Checked="NavHub_Checked"/>
                        
                        <!-- Hub 3: Format Sonrası Kurulum & İnce Ayarlar -->
                        <RadioButton x:Name="NavHubPostFormat" Content="🚀  Format Sonrası &amp; İnce Ayarlar" ToolTip="27+ Katılımsız Paket, Klasik Sağ Tuş &amp; Debloat" Style="{StaticResource FluentNavButton}" Checked="NavHub_Checked"/>
                        
                        <!-- Hub 4: Sistem Onarımı & Bakım -->
                        <RadioButton x:Name="NavHubRepair" Content="🔧  Sistem Onarımı &amp; Bakım" ToolTip="Temizlik, Ağ Onarımı, SFC/DISM &amp; Geri Yükleme" Style="{StaticResource FluentNavButton}" Checked="NavHub_Checked"/>
                        
                        <!-- Hub 5: Yapay Zekâ Teşhis & Web Çözüm -->
                        <RadioButton x:Name="NavHubAI" Content="🤖  Yapay Zekâ &amp; Web Çözüm" ToolTip="Resmi Microsoft Kaynakları, Topluluk Forumları &amp; Onaylı Rozet" Style="{StaticResource FluentNavButton}" Checked="NavHub_Checked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Bottom Status Footer -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource BrushBgSidebar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="TxtSidebarFooterText" Grid.Column="0">
                            <TextBlock Text="WinoxIT v1.0.0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtServerMiniStatus" Text="Sunucu: Kontrol ediliyor..." FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource FluentBadge}" HorizontalAlignment="Center">
                            <TextBlock Text="NET 8 / RUST" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Quick Launcher -->
            <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="📊 Genel Bakış &amp; Durum" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Tüm çekirdek modüller, donanım parmak izi ve ağ operasyonları hazır." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Theme Toggle Button -->
                        <Button x:Name="BtnThemeToggle" Content="🌙 Koyu Tema" Style="{StaticResource FluentThemeToggleBtn}" Margin="0,0,10,0" Click="BtnThemeToggle_Click"/>
                        
                        <!-- Quick Actions -->
                        <Button x:Name="BtnQuickServer" Content="🌐 Web Kokpitini Aç (Port 9999)" Style="{StaticResource FluentButton}" Margin="0,0,10,0" Click="BtnQuickServer_Click"/>
                        <Button x:Name="BtnQuickClean" Content="🧹 Hızlı Temizle" Style="{StaticResource FluentButton}" Margin="0,0,10,0" Click="BtnQuickClean_Click"/>
                        <Button x:Name="BtnFlushDns" Content="📡 DNS Temizle" Style="{StaticResource FluentButton}" Click="BtnFlushDns_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area with 5 Category Hubs -->
            <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
                <Grid>

                    <!-- ============================================================== -->
                    <!-- HUB 1: KONTROL MERKEZİ & AĞ FİLOSU                            -->
                    <!-- ============================================================== -->
                    <StackPanel x:Name="PanelHubDashboard" Visibility="Visible">
                        <!-- Category Sub-Navigation Pills -->
                        <WrapPanel Margin="0,0,0,16">
                            <RadioButton x:Name="SubNavDashboard" Content="📊 Genel Bakış" Style="{StaticResource FluentSubNavPill}" IsChecked="True" Checked="SubNavDashboard_Checked" Margin="0,0,8,6"/>
                            <RadioButton x:Name="SubNavLanFleet" Content="📡 Ağ Filo Keşfi" Style="{StaticResource FluentSubNavPill}" Checked="SubNavDashboard_Checked" Margin="0,0,8,6"/>
                            <RadioButton x:Name="SubNavLanServer" Content="🌐 Web Kokpiti &amp; HTTP" Style="{StaticResource FluentSubNavPill}" Checked="SubNavDashboard_Checked" Margin="0,0,8,6"/>
                            <RadioButton x:Name="SubNavIsoStudio" Content="💿 Katılımsız ISO / WIM" Style="{StaticResource FluentSubNavPill}" Checked="SubNavDashboard_Checked" Margin="0,0,8,6"/>
                        </WrapPanel>

                        <!-- Sub-View 1: Dashboard Panel -->
                        <StackPanel x:Name="PanelDashboard" Visibility="Visible">
                            <!-- Metric Cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FluentCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="SİSTEM DURUMU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtHealthStatus" Text="SAĞLIKLI (%98)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" Margin="0,6,0,0"/>
                                        <TextBlock Text="0 Kritik Sistem Sorunu" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource FluentCard}" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="İŞLEMCİ YÜKÜ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtCpuLoad" Text="%12" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtCpuName" Text="16 Çekirdek Aktif" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource FluentCard}" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="RAM KULLANIMI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtRamLoad" Text="%42" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtRamTotal" Text="13.4 GB / 32 GB" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource FluentCard}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="DİSK ALANI (C:)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtDiskLoad" Text="342 GB BOŞ" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtDiskSpace" Text="Toplam: 512 GB NVMe" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- System Overview Banner -->
                            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="💻 İş İstasyonu ve Ağ Kimliği" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="İŞLETİM SİSTEMİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock x:Name="TxtOsInfo" Text="Windows 11 Pro 23H2" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="BİLGİSAYAR ADI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock x:Name="TxtHostName" Text="WINOX-DESKTOP" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="YEREL IP ADRESİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock x:Name="TxtIpAddress" Text="192.168.1.100" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="AÇIK KALMA SÜRESİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock x:Name="TxtUptime" Text="02 Gün 04 Saat" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Hub Action Launcher -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="⚡ Hızlı Bakım &amp; Sağlık Taraması" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Tüm donanım, sürücü ve işletim sistemi bileşenlerini tek tıkla tarayarak detaylı teşhis raporu hazırlayın." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="BtnScanHealth" Content="🔍 Tam Sistem Sağlık Taramasını Başlat" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnScanHealth_Click"/>
                                        <Button x:Name="BtnExportReport" Content="📋 HTML Sağlık Raporu Oluştur &amp; İndir" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnExportReport_Click"/>
                                        <Button x:Name="BtnRefreshDashboard" Content="🔄 Metrikleri Yenile" Style="{StaticResource FluentButton}" Margin="0,0,10,10" Click="BtnRefreshDashboard_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Sub-View 2: LanFleet Panel -->
                        <StackPanel x:Name="PanelLanFleet" Visibility="Collapsed">
                            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="📡 Ethernet / Wi-Fi Ağ Keşfi &amp; Yerel IP Tarayıcısı" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Sistemdeki Ethernet ve Wi-Fi kartlarını algılar; seçilen ağ kartının yerel alt ağındaki (Subnet) açık, korumalı (firewall) ve boşta olan tüm IP adreslerini ve cihazlarını listeler." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                                    <!-- Ağ Kartı Seçimi ve IP Aralığı -->
                                    <Border Background="{DynamicResource BrushBgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Row 0: Network Adapter ComboBox -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ağ Kartı:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <ComboBox x:Name="CmbNetworkAdapters" Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                                                      DisplayMemberPath="DisplayText" SelectionChanged="CmbNetworkAdapters_SelectionChanged"
                                                      Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="🔄 Kartları Yenile" Style="{StaticResource FluentButton}" Height="32" Margin="8,0,0,0" Click="BtnRefreshAdapters_Click"/>

                                            <!-- Row 2: Subnet Range and Action Buttons -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Tarama Aralığı:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="TxtScanRangeStart" Text="192.168.1.1" Width="130" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Padding="6,2" Margin="0,0,6,0"/>
                                                <TextBlock Text="—" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="TxtScanRangeEnd" Text="192.168.1.254" Width="130" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Padding="6,2" Margin="0,0,12,0"/>

                                                <Button x:Name="BtnStartSubnetScan" Content="🚀 IP Taramasını Başlat" Style="{StaticResource FluentButtonPrimary}" Height="32" Margin="0,0,8,0" Click="BtnStartSubnetScan_Click"/>
                                                <Button x:Name="BtnStopSubnetScan" Content="🛑 Durdur" Style="{StaticResource FluentButton}" Height="32" Margin="0,0,12,0" IsEnabled="False" Click="BtnStopSubnetScan_Click"/>
                                                
                                                <TextBlock x:Name="TxtScanStatusHint" Text="Tarama bekleniyor..." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Progress Bar -->
                                    <ProgressBar x:Name="ProgressSubnetScan" Height="5" Minimum="0" Maximum="254" Value="0" Margin="0,0,0,12" Background="{DynamicResource BrushBorder}" Foreground="{DynamicResource BrushAccent}"/>

                                    <!-- KPI İstatistik Sayaçları (Açık, Korumalı, Boşta) -->
                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <Border Background="{DynamicResource BrushBgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="🟢 AÇIK CİHAZLAR" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                                <TextBlock x:Name="TxtCountOnline" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                                <TextBlock Text="ARP / Ping yanıtı veren" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushBgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="🟡 KORUMALI CİHAZLAR" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                                <TextBlock x:Name="TxtCountFirewall" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                                <TextBlock Text="Firewall Ping bloklu (ARP var)" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushBgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="⚪ BOŞTA (KULLANILABİLİR)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock x:Name="TxtCountIdle" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                                <TextBlock Text="Serbest / Yanıtsız IP'ler" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushBgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="📊 TOPLAM TARANAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                                <TextBlock x:Name="TxtCountTotal" Text="0 / 0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="TxtScanDuration" Text="Süre: 0s" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Filtre Butonları ve Arama -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button x:Name="BtnFilterAll" Content="Tümü" Style="{StaticResource FluentButton}" Height="28" Padding="10,2" Margin="0,0,6,0" Click="BtnFilterLan_Click" Tag="All"/>
                                            <Button x:Name="BtnFilterOnline" Content="🟢 Sadece Açık &amp; Korumalı" Style="{StaticResource FluentButton}" Height="28" Padding="10,2" Margin="0,0,6,0" Click="BtnFilterLan_Click" Tag="Online"/>
                                            <Button x:Name="BtnFilterIdle" Content="⚪ Sadece Boşta IP'ler" Style="{StaticResource FluentButton}" Height="28" Padding="10,2" Click="BtnFilterLan_Click" Tag="Idle"/>
                                        </StackPanel>

                                        <TextBox x:Name="TxtFilterHost" Grid.Column="2" Text="" Height="28" VerticalContentAlignment="Center"
                                                 Padding="6,2" Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}"
                                                 BorderBrush="{DynamicResource BrushBorder}" TextChanged="TxtFilterHost_TextChanged"
                                                 ToolTip="IP adresi, MAC veya Cihaz adı ile filtreleyin..."/>
                                    </Grid>

                                    <!-- Cihaz Tablosu -->
                                    <Border Background="{DynamicResource BrushBgWindow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" MinHeight="220" MaxHeight="320">
                                        <DataGrid x:Name="GridLanFleet" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" 
                                                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                                  Foreground="{DynamicResource BrushTextPrimary}" SelectionChanged="GridLanFleet_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="IP Adresi" Binding="{Binding IPAddress}" Width="115" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="135"/>
                                                <DataGridTextColumn Header="Cihaz Türü" Binding="{Binding DeviceType}" Width="190" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Cihaz Adı / NetBIOS" Binding="{Binding Hostname}" Width="160"/>
                                                <DataGridTextColumn Header="Üretici / Marka" Binding="{Binding Vendor}" Width="130"/>
                                                <DataGridTextColumn Header="MAC Adresi" Binding="{Binding MACAddress}" Width="135"/>
                                                <DataGridTextColumn Header="Portlar" Binding="{Binding OpenPorts}" Width="95"/>
                                                <DataGridTextColumn Header="Gecikme" Binding="{Binding Latency}" Width="85"/>
                                                <DataGridTemplateColumn Header="Hızlı Bağlantı &amp; Eylem" Width="200">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Button Content="📁 SMB" Style="{StaticResource FluentButton}" Height="24" Padding="6,1" Margin="0,0,4,0" 
                                                                        ToolTip="Windows Paylaşımını Aç (\\IP)" 
                                                                        Click="BtnHostActionSmb_Click" Tag="{Binding}"/>
                                                                <Button Content="🖥️ RDP" Style="{StaticResource FluentButton}" Height="24" Padding="6,1" Margin="0,0,4,0" 
                                                                        ToolTip="Uzak Masaüstü Bağlantısı (mstsc /v:IP)" 
                                                                        Click="BtnHostActionRdp_Click" Tag="{Binding}"/>
                                                                <Button Content="🔍 Detay" Style="{StaticResource FluentButton}" Height="24" Padding="6,1" 
                                                                        ToolTip="Cihaz Ayrıntılarını ve Port Raporunu Gör" 
                                                                        Click="BtnHostActionDetail_Click" Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
